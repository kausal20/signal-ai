VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# ─── Server-side only (Supabase Secrets) ───────────────────────────────────
# These are NOT placed in .env. Set them as Supabase secrets:
#   supabase secrets set --project-ref your-project-ref MESH_API_KEY=your-mesh-key DEFAULT_AI_MODEL=your-supported-model
#
# MESH_API_KEY       — MeshAPI key for all AI features.
# MESH_BASE_URL      — Optional MeshAPI base URL (defaults to https://api.meshapi.ai/v1).
# DEFAULT_AI_MODEL   — A model returned by MeshAPI's /models endpoint.
# AI_TIMEOUT_MS      — Optional request timeout in milliseconds (defaults to 30000).
# AI_MAX_RETRIES     — Optional retry count for 429/5xx responses (defaults to 2).
# Never expose server-side values to the frontend.
